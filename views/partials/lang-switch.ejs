<%
  // У шапці — орієнтир <nav>; у підвалі й мобільному меню — звичайна група (щоб не дублювати
  // орієнтири з однаковою назвою). Посилання названі повною назвою мови («Українська», «English»).
  const switchTag = typeof switchNav !== 'undefined' && switchNav ? 'nav' : 'div';
-%>
<% if (langs.length > 1) { -%>
      <<%= switchTag %> class="<%= switchCls %>"<% if (switchTag === 'div') { %> role="group"<% } %> aria-label="<%= kit.L.language %>">
<% langs.forEach((l, i) => { -%>
<% if (i > 0) { %><span class="lang-switch__sep" aria-hidden="true"></span><% } -%>
        <a class="lang-switch__link" href="<%= l.href %>" hreflang="<%= l.code %>" lang="<%= l.code %>" aria-label="<%= l.label %>"<% if (l.active) { %> aria-current="true"<% } %>><%= l.short %></a>
<% }) -%>
      </<%= switchTag %>>
<% } -%>
