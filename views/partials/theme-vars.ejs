<%
  // Власні кольори (theme.preset = 'custom'): власниця може обрати будь-який акцент і фон.
  // Тут підбираємо кольори ТЕКСТУ так, щоб усе лишалося читабельним (WCAG AA 4.5:1):
  //   --on-accent    — текст на кнопках (кремовий на темному акценті, темний — на світлому);
  //   --accent-strong — акцентний текст (надзаголовки, ціни) — темнішаємо/світлішаємо акцент, доки не стане контрастним до фону;
  //   темний фон → світлий основний текст, лінії й картки.
  // Вивід — рядок CSS-оголошень для style="" на <html> (лише #rrggbb і rgba, екранування не потрібне).
  const HEX = /^#[0-9a-f]{6}$/i;
  const accentHex = theme && HEX.test(theme.accent || '') ? theme.accent : '';
  const bgHex = theme && HEX.test(theme.background || '') ? theme.background : '';
  let out = '';
  if (accentHex && bgHex) {
    const rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const hex = (c) => '#' + c.map((v) => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, '0')).join('');
    const lin = (v) => { const c = v / 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
    const lum = (c) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
    const ratio = (a, b) => { const x = lum(a); const y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
    const mix = (a, b, p) => a.map((v, i) => v * p + b[i] * (1 - p)); // p — частка кольору a

    const CREAM = [255, 253, 251];
    const INK = [58, 48, 41];
    const accent = rgb(accentHex);
    const bg = rgb(bgHex);
    const darkBg = ratio(INK, bg) < 4.5 && ratio(CREAM, bg) > ratio(INK, bg);

    // текст на кнопках
    const onAccent = ratio(CREAM, accent) >= 4.5 || ratio(CREAM, accent) >= ratio(INK, accent) ? CREAM : INK;
    out += `--on-accent:${hex(onAccent)};`;

    // акцентний текст: як у CSS (78% акценту + чорний), але не світліше за 4.5:1 до фону
    const toward = darkBg ? [255, 255, 255] : [0, 0, 0];
    let strong = mix(accent, toward, 0.78);
    for (let p = 0.78; p >= 0 && ratio(strong, bg) < 4.6; p -= 0.04) strong = mix(accent, toward, Math.max(0, p));
    out += `--accent-strong:${hex(strong)};`;

    if (darkBg) {
      const text = [246, 241, 234];
      let muted = mix(text, bg, 0.72);
      for (let p = 0.72; p <= 1 && ratio(muted, bg) < 4.8; p += 0.04) muted = mix(text, bg, Math.min(1, p));
      out += `--ink:${hex(text)};--muted:${hex(muted)};`;
      out += `--surface:${hex(mix([255, 255, 255], bg, 0.07))};`;
      out += '--line:rgba(255,253,251,.16);--line-strong:rgba(255,253,251,.3);';
    } else {
      // Світлий, але не білий фон: вторинний текст (#74675c) темнішаємо в бік основного,
      // доки він не матиме 4.6:1 до фону (і 4.5:1 у секціях на тоні bg-alt, де він ще трохи темніший)
      const MUTED = [116, 103, 92];
      const bgAlt = mix(bg, accent, 0.9);
      const mutedOk = (m) => ratio(m, bg) >= 4.6 && ratio(mix(m, INK, 0.82), bgAlt) >= 4.5;
      if (!mutedOk(MUTED)) {
        let muted = MUTED;
        for (let p = 0.96; p >= 0 && !mutedOk(muted); p -= 0.04) muted = mix(MUTED, INK, Math.max(0, p));
        out += `--muted:${hex(muted)};`;
      }
    }
  }
-%>
<%- out %>
