<%
  // Без JS кнопка веде до контактів; якщо секцію «Контакти» приховано — одразу в перший месенджер
  const fabHref = kit.shownTypes.includes('contact') ? '#contact' : (messengers[0] && messengers[0].href) || '#';
-%>
<% if (contacts.showFloatingButton && messengers.length) { -%>
<div class="fab" data-fab>
  <ul class="fab__list" id="fab-list" data-fab-list>
<% messengers.forEach((m, i) => { -%>
    <li style="--i: <%= messengers.length - 1 - i %>">
      <a class="fab__link" href="<%= m.href %>"<% if (/^https:/.test(m.href)) { %> target="_blank" rel="noopener"<% } %>>
        <span class="fab__label"><%= m.label || m.display %></span>
        <span class="fab__icon"><%- icon(m.key) %></span>
      </a>
    </li>
<% }) -%>
  </ul>
  <a class="fab__toggle" href="<%= fabHref %>" data-fab-toggle aria-controls="fab-list" aria-label="<%= kit.ui('contactMe') %>" data-label-open="<%= kit.ui('contactMe') %>" data-label-close="<%= kit.ui('close') %>">
    <span class="fab__toggle-icon fab__toggle-icon--open"><%- icon('chat') %></span>
    <span class="fab__toggle-icon fab__toggle-icon--close"><%- icon('close') %></span>
  </a>
</div>
<% } -%>
